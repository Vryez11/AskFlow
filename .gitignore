# Claude Code 설정. 팀이 같이 쓰는 하네스(.claude/settings.json)만 커밋하고,
# 개인 설정과 OpenSpec이 만든 명령·스킬은 제외한다
.claude/*
!.claude/settings.json
CLAUDE.local.md

# 비밀 값
.env
.env.*
!.env.example

# 검증용 원본 데이터 (Olist는 비상업 라이선스라 커밋하지 않는다)
data/raw/

# 파이프라인 실행 기록 (하네스 디버깅용)
logs/

# 의존성과 빌드 결과
node_modules/
dist/
build/
coverage/
.gradle/
.kotlin/

# OS와 에디터
.DS_Store
.idea/
.vscode/
