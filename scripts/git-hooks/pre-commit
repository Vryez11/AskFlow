#!/bin/bash
# main 브랜치에는 직접 커밋하지 않는다 (conventions/branch.md 5번).
# 설치: git config core.hooksPath scripts/git-hooks
set -euo pipefail

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [ "$branch" = "main" ]; then
  echo "main에는 직접 커밋하지 않습니다. develop이나 작업 브랜치에서 커밋하고 PR로 합치세요." >&2
  exit 1
fi
