# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# 로컬 MySQL (docker-compose.yml)
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
# 서비스 DB(askflow)용 계정 askflow_app의 비밀번호
ASKFLOW_DB_PASSWORD=
# 분석 대상 DB(olist)를 읽기만 하는 계정 askflow_reader의 비밀번호
ASKFLOW_READER_PASSWORD=

# LLM API 키. LLM 연동(F-002)부터 쓴다. 공급자 선택과 자동 전환은 아키텍처 문서 7장
# Gemini API 키. 개발·평가는 무료 등급을 쓰니, Google AI Studio에서 결제 계정을 연결하지 않은 프로젝트로 받는다
GEMINI_API_KEY=
# Claude API 키. Claude를 공급자 목록에 넣을 때만 쓴다
ANTHROPIC_API_KEY=
