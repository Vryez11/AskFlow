# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# 로컬 MySQL (docker-compose.yml)
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
# 서비스 DB(askflow)용 계정 askflow_app의 비밀번호
ASKFLOW_DB_PASSWORD=
# 분석 대상 DB(olist)를 읽기만 하는 계정 askflow_reader의 비밀번호
# 분석 대상 DB 연결(F-003)에서 쓴다. api가 askflow.target-db.password로 받는다.
# 비어 있으면 api는 뜨고 홈의 연결 상태만 "연결 실패"가 된다
ASKFLOW_READER_PASSWORD=

# Claude API 키. LLM 연동(F-002)부터 쓴다
ANTHROPIC_API_KEY=
